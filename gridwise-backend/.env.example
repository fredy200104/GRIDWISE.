# Puerto del servidor (por defecto 3000)
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=development

# ─── Google Gemini AI ──────────────────────────────────────────────────────────
# Obtén tu API Key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini a usar (por defecto: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ─── MQTT — Broker IoT ────────────────────────────────────────────────────────
# URL del broker MQTT (ejemplo: mqtt://localhost:1883 o mqtts://broker.hivemq.com:8883)
MQTT_BROKER_URL=mqtt://tu_broker_mqtt:1883
MQTT_USERNAME=tu_usuario_mqtt
MQTT_PASSWORD=tu_password_mqtt
# Topic principal a suscribir (# = wildcard para todos los sub-topics)
MQTT_TOPIC=gridwise/devices/#

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Ruta al archivo serviceAccountKey.json descargado desde Firebase Console
# Firebase Console → Configuración → Cuentas de servicio → Generar nueva clave privada
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma (dejar vacío para permitir todos en desarrollo)
# En producción: especifica los dominios reales de tu app web
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000
