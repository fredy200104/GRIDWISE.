# GRIDWISE Backend .gitignore

# Dependencies
node_modules/
npm-debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# Build output
dist/
build/
.tsc/
out/
*.bundle.js

# Test coverage
coverage/
.nyc_output/

# Logs
logs/
*.log

# Temp files
tmp/
temp/
*.tmp

# Firebase
.firebase/
.firebaserc
firebase-debug.log*

# OS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
ehthumbs.db

# Package lock files (optional - depends on your workflow)
# package-lock.json
# yarn.lock

# Compiled files
*.js.map
*.ts.map

# Runtime data
*.pid
*.seed

# Optional REPL history
.node_repl_history

# Credentials
*.pem
*.key
*.cert
*.crt
credentials/
secrets/

# Docker
docker-compose.override.yml
.docker/

# IDE specific
.eslintcache
.prettierignore

# Backup files
*.backup
*.bak
