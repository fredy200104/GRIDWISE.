*.g.dart
*.freezed.dart
*.mocks.dart

# ─── Android ──────────────────────────────────────────────────────────────────
# Configuración local con rutas absolutas al SDK (no portable entre máquinas)
android/local.properties
/android/app/debug
/android/app/profile
/android/app/release

# Keystore de firma de releases (NUNCA subir al repositorio)
*.jks
*.keystore
android/key.properties

# ─── iOS ──────────────────────────────────────────────────────────────────────
ios/Flutter/flutter_export_environment.sh
ios/.symlinks/
ios/Pods/
ios/Podfile.lock

# ─── Symbols / Obfuscation ────────────────────────────────────────────────────
app.*.symbols
app.*.map.json

# ─── Secrets / Variables de entorno ──────────────────────────────────────────
# NUNCA subir credenciales privadas al repositorio
.env
.env.*
!.env.example
*.pem
*serviceAccount*.json
firebase-adminsdk*.json

# ─── Google Firebase — Archivos de configuración privados ─────────────────────
# El google-services.json (Android) ya está incluido con datos reales de Firebase.
# Si prefieres excluirlo también, descomenta la siguiente línea:
#google-services.json

# GoogleService-Info.plist de iOS: contiene API keys privadas
# El archivo en el repo es un PLACEHOLDER — el real debe obtenerse de Firebase Console
# y debe IGNORARSE aquí para no sobreescribir el placeholder con datos reales accidentalmente.
# Agrega la ruta exacta si quieres ignorar el real:
#ios/Runner/GoogleService-Info.plist

# ─── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
